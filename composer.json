{
    "name": "zoreal/oauth2",
    "description": "Login with ZOREAL for PHP backends: exchanges the authorization code your frontend received from @zoreal/oauth2-react, verifies the ID token against the provider's JWKS, and reads personal claims from /userinfo.",
    "version": "0.1.4",
    "type": "library",
    "license": "MIT",
    "homepage": "https://zoreal.com",
    "support": {
        "source": "https://github.com/Bynn-Intelligence/zoreal-oauth2-php",
        "issues": "https://github.com/Bynn-Intelligence/zoreal-oauth2-php/issues"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zoreal\\OAuth2\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoreal\\OAuth2\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
